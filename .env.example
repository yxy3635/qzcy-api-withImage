# Copy to .env. Empty required values deliberately prevent startup.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
# Public origin, no trailing slash; include port if not 80/443.
SITE_URL=http://your-server-ip
MYSQL_USER=imagecreater
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Use a random string of at least 32 bytes (e.g. openssl rand -hex 32).
JWT_SECRET=
# Used only when creating admin for the first time.
ADMIN_INITIAL_PASSWORD=
# Configure image models and upstream credentials in the admin UI after startup.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
